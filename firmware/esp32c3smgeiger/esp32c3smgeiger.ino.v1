#include <WiFi.h>
#include <WebServer.h>
#include "wifi_secrets.h"

WebServer server(80);

/* ================================
   SAFE GPIO (IMPORTANT FOR C3)
================================ */

// Avoid strapping/flash pins on C3 boards.
// Recommended safe GPIOs: 2, 3, 4, 5, 6, 7
static constexpr int GM_PIN = 6;

/* ================================
   GEIGER STATE (ISR SAFE)
================================ */

volatile uint32_t pulseCount = 0;
volatile uint32_t lastPulseUs = 0;

/* ISR: MUST be ultra minimal */
void IRAM_ATTR geigerISR()
{
    uint32_t now = micros();

    // debounce / dead time (~200 µs typical tube pulse)
    if (now - lastPulseUs < 200) return;

    lastPulseUs = now;
    pulseCount++;
}

/* ================================
   CPU TEMP (DIAGNOSTIC)
================================ */

float readCpuTemp()
{
//~ #if defined(CONFIG_IDF_TARGET_ESP32C3)
    //~ return NAN; // unreliable on C3 in many builds
//~ #else
    return temperatureRead();
//~ #endif
}

/* ================================
   DATA BUFFER
================================ */

constexpr int MAX_POINTS = 120;

float tempBuf[MAX_POINTS];
uint32_t cpsBuf[MAX_POINTS];

int idx = 0;
bool full = false;

uint32_t lastSampleMs = 0;

/* ================================
   WIFI
================================ */

void connectWifi()
{
    WiFi.mode(WIFI_STA);
    WiFi.setSleep(false);

    WiFi.begin(WIFI_SSID, WIFI_PASS);

    Serial.print("WiFi connecting");

    for (int i = 0; i < 40; i++)
    {
        if (WiFi.status() == WL_CONNECTED) break;
        delay(250);
        Serial.print(".");
    }

    Serial.println();

    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.print("IP: ");
        Serial.println(WiFi.localIP());
    }
    else
    {
        Serial.println("WiFi FAILED");
    }
}

/* ================================
   BUFFER PUSH
================================ */

void push(float t, uint32_t cps)
{
    tempBuf[idx] = t;
    cpsBuf[idx] = cps;

    idx++;
    if (idx >= MAX_POINTS)
    {
        idx = 0;
        full = true;
    }
}

/* ================================
   JSON OUTPUT
================================ */

String makeJSON()
{
    String s = "{";

    int n = full ? MAX_POINTS : idx;

    s += "\"temp\":[";
    for (int i = 0; i < n; i++)
    {
        s += String(tempBuf[i], 2);
        if (i < n - 1) s += ",";
    }

    s += "],\"cps\":[";

    for (int i = 0; i < n; i++)
    {
        s += String(cpsBuf[i]);
        if (i < n - 1) s += ",";
    }

    s += "]}";

    return s;
}

/* ================================
   WEB UI
================================ */

void handleRoot()
{
    server.send(200, "text/html", R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>ESP32 Geiger</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<h2>Geiger CPS + CPU Temp</h2>

<canvas id="t"></canvas>
<canvas id="c"></canvas>

<script>

const tChart = new Chart(document.getElementById('t'), {
    type:'line',
    data:{labels:[], datasets:[{label:'Temp °C', data:[]}]},
    options:{animation:false}
});

const cChart = new Chart(document.getElementById('c'), {
    type:'line',
    data:{labels:[], datasets:[{label:'CPS', data:[]}]},
    options:{animation:false}
});

async function update()
{
    const r = await fetch('/data');
    const d = await r.json();

    tChart.data.labels = d.temp.map((_,i)=>i);
    tChart.data.datasets[0].data = d.temp;

    cChart.data.labels = d.cps.map((_,i)=>i);
    cChart.data.datasets[0].data = d.cps;

    tChart.update();
    cChart.update();
}

setInterval(update, 1000);
update();

</script>
</body>
</html>
)rawliteral");
}

void handleData()
{
    server.send(200, "application/json", makeJSON());
}

/* ================================
   SETUP
================================ */

void setup()
{
    Serial.begin(115200);
    delay(1500);

    Serial.println("\nESP32-C3 Geiger + Temp");
    
    setCpuFrequencyMhz(80);   // optimal speed

    /* IMPORTANT: stabilize GPIO before ISR */
    pinMode(GM_PIN, INPUT);

    connectWifi();

    server.on("/", handleRoot);
    server.on("/data", handleData);
    server.begin();

    /* attach interrupt AFTER WiFi init (prevents boot storms) */
    attachInterrupt(digitalPinToInterrupt(GM_PIN), geigerISR, RISING);

    Serial.println("Web server ready");
}

/* ================================
   LOOP (LOW CPU)
================================ */

void loop()
{
    server.handleClient();

    if (millis() - lastSampleMs >= 1000)
    {
        lastSampleMs = millis();

        uint32_t cps;

        noInterrupts();
        cps = pulseCount;
        pulseCount = 0;
        interrupts();

        float t = readCpuTemp();

        push(t, cps);

        Serial.printf("CPS=%u TEMP=%.2f\n", cps, t);
    }
}
